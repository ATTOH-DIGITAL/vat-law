# vat.law — env vars (Vertical #25)
# Copy to .env.local and fill before running `npm run dev`

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIALS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CROSSBORDER=
STRIPE_PRICE_ESSENTIALS_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_CROSSBORDER_ANNUAL=
STRIPE_PRICE_HMRC_ENQUIRY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@vat.law
PDF_RENDERER_URL=

# HMRC MTD VAT API — production: https://api.service.hmrc.gov.uk · sandbox: https://test-api.service.hmrc.gov.uk
HMRC_MTD_BASE_URL=https://test-api.service.hmrc.gov.uk
HMRC_MTD_CLIENT_ID=
HMRC_MTD_CLIENT_SECRET=
HMRC_MTD_REDIRECT_URI=https://vat.law/api/integrations/hmrc/callback
HMRC_MTD_SCOPES=read:vat write:vat
HMRC_FRAUD_PREVENTION_VENDOR_PRODUCT_NAME=vat.law
HMRC_FRAUD_PREVENTION_VENDOR_VERSION=0.1.0

# Bookkeeping connectors — OAuth2 client credentials per platform
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://vat.law/api/integrations/xero/callback
XERO_SCOPES=offline_access accounting.transactions.read accounting.settings.read

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://vat.law/api/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=https://vat.law/api/integrations/sage/callback

FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
FREEAGENT_REDIRECT_URI=https://vat.law/api/integrations/freeagent/callback

# CTA / CIOT / ATT partner adviser routing for HMRC enquiry tier
CTA_PARTNER_NAME=
CTA_PARTNER_CIOT_NUMBER=
CTA_PARTNER_WEBHOOK_URL=
CTA_PARTNER_API_KEY=
CTA_PARTNER_REFERRAL_FEE_PCT=20

# India QA — human-in-the-loop review queue (Pro + Cross-Border tier)
INDIA_QA_QUEUE_WEBHOOK=
INDIA_QA_QUEUE_API_KEY=

# Cross-vertical fan-in / fan-out webhook secrets
FORM_LAW_WEBHOOK_SECRET=
SOLE_TAX_WEBHOOK_SECRET=
ACCOUNTS_LAW_WEBHOOK_SECRET=
LANDLORD_TAX_WEBHOOK_SECRET=
SUPREME_CAPITAL_WEBHOOK_URL=

# n8n internal orchestration
N8N_BASE_URL=

JWT_SECRET=

# Feature flags
FEATURE_THRESHOLD_CHECK=true
FEATURE_RETURN_SUBMIT=true
FEATURE_PARTIAL_EXEMPTION=true
FEATURE_DRC=true
FEATURE_MARGIN_SCHEME=true
FEATURE_OSS_IOSS=true
FEATURE_CGS=true
FEATURE_TOMS=true
FEATURE_GROUP_VAT=true
FEATURE_ENQUIRY_STUDIO=true
FEATURE_INDIA_QA=true
FEATURE_CROSSSELL=true
