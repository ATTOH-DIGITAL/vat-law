# vat.law env vars · fill before Railway deploy
# Vertical #25 of Supreme Operating System
# Essentials £19/mo · Pro £49/mo · Cross-Border £149/mo · HMRC enquiry £495 one-off
# Annual variants = 2 months free

# ----------------------------------------------------------------------------
# Core Supabase
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_RETURNS=vat-returns
SUPABASE_STORAGE_BUCKET_INVOICES=vat-invoices
SUPABASE_STORAGE_BUCKET_DOCUMENTS=vat-documents
SUPABASE_STORAGE_BUCKET_ENQUIRY=vat-hmrc-enquiry

# ----------------------------------------------------------------------------
# Claude (Anthropic)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
CLAUDE_MODEL_LIGHT=claude-haiku-4-5-20251001
CLAUDE_MODEL_VISION=claude-sonnet-4-6
CLAUDE_MODEL_ENQUIRY=claude-opus-4-8

# ----------------------------------------------------------------------------
# Billing — Stripe
# Three tiers: Essentials £19 · Pro £49 · Cross-Border £149
# Annual variants = 2 months free
# Plus one-off: HMRC enquiry response £495
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIALS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CROSS_BORDER=
STRIPE_PRICE_ESSENTIALS_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_CROSS_BORDER_ANNUAL=
STRIPE_PRICE_HMRC_ENQUIRY=

# ----------------------------------------------------------------------------
# PDF rendering (Puppeteer worker)
#  - Partial-exemption memos · DRC invoice packs · margin-scheme records ·
#    OSS return drafts · HMRC enquiry response binders
# ----------------------------------------------------------------------------
PDF_RENDERER_URL=
PDF_RENDERER_TIMEOUT_MS=60000

# ----------------------------------------------------------------------------
# Email (Resend)
# ----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@vat.law
RESEND_REPLY_TO=support@vat.law
RESEND_ENQUIRY_FROM=enquiry@vat.law

# ----------------------------------------------------------------------------
# HMRC MTD VAT API
#  - Sanctioned REST API · OAuth2 client_credentials + user-authorised flows
#  - Fraud-prevention headers REQUIRED on every call (HMRC spec)
#  - Base URL switches sandbox / production via HMRC_VAT_BASE
# ----------------------------------------------------------------------------
HMRC_VAT_BASE=https://api.service.hmrc.gov.uk
HMRC_VAT_CLIENT_ID=
HMRC_VAT_CLIENT_SECRET=
HMRC_VAT_REDIRECT_URI=https://vat.law/api/integrations/hmrc/callback
HMRC_VAT_SCOPE=read:vat write:vat
HMRC_VAT_SERVER_TOKEN=
HMRC_VAT_TEST_USER_ID=

# HMRC mandatory Fraud-Prevention Headers — see HMRC API spec "Tx-Monitoring"
# These are static, platform-level values; user-specific values are added per-request.
HMRC_FRAUD_VENDOR_PRODUCT_NAME=vat.law
HMRC_FRAUD_VENDOR_VERSION=1.0.0
HMRC_FRAUD_VENDOR_LICENSE_IDS=
HMRC_FRAUD_VENDOR_PUBLIC_IP=
HMRC_FRAUD_GOV_CLIENT_CONNECTION_METHOD=WEB_APP_VIA_SERVER
HMRC_FRAUD_GOV_VENDOR_FORWARDED=

# ----------------------------------------------------------------------------
# Xero OAuth2 — accounting system integration
# ----------------------------------------------------------------------------
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://vat.law/api/integrations/xero/callback
XERO_SCOPES=offline_access accounting.transactions accounting.contacts accounting.settings accounting.reports.read

# ----------------------------------------------------------------------------
# QuickBooks Online OAuth2
# ----------------------------------------------------------------------------
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=https://vat.law/api/integrations/quickbooks/callback
QB_ENVIRONMENT=production
QB_SCOPES=com.intuit.quickbooks.accounting

# ----------------------------------------------------------------------------
# Sage Business Cloud OAuth2
# ----------------------------------------------------------------------------
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=https://vat.law/api/integrations/sage/callback
SAGE_SCOPES=full_access

# ----------------------------------------------------------------------------
# FreeAgent OAuth2
# ----------------------------------------------------------------------------
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
FREEAGENT_REDIRECT_URI=https://vat.law/api/integrations/freeagent/callback

# ----------------------------------------------------------------------------
# India QA queue
#  - Every regulator-facing output (MTD submission, OSS return, partial-exemption
#    memo, HMRC enquiry response) routes through India QA before CTA partner sign.
# ----------------------------------------------------------------------------
INDIA_QA_QUEUE_WEBHOOK=
INDIA_QA_QUEUE_API_KEY=
INDIA_QA_REVIEWER_GROUP=vat_qa

# ----------------------------------------------------------------------------
# CTA partner adviser webhook (regulated complex-VAT advice referral layer)
#  - 3 seed firms in DB: see vat_cta_partners reference table.
#  - vat.law is NOT a regulated tax adviser. Complex-VAT advice on customer
#    specific facts (partial-exemption methodology, TOMS, capital goods scheme,
#    HMRC enquiry response) is signed off by a CTA / CIOT / ATT partner.
# ----------------------------------------------------------------------------
CTA_PARTNER_WEBHOOK_URL=
CTA_PARTNER_WEBHOOK_SECRET=
CTA_PARTNER_REFERRAL_API_KEY=
CTA_PARTNER_DEFAULT_FIRM_ID=

# ----------------------------------------------------------------------------
# Supreme Capital (FCA AR — finance referrals)
#  - HMRC liability advance financing (CT, VAT, PAYE arrears via FCA AR broker)
# ----------------------------------------------------------------------------
SUPREME_CAPITAL_WEBHOOK_URL=
SUPREME_CAPITAL_API_KEY=
SUPREME_CAPITAL_PRODUCT_CODE=VAT_LIABILITY_ADVANCE

# ----------------------------------------------------------------------------
# Cross-vertical webhooks (verticals that signal into vat.law)
# ----------------------------------------------------------------------------
FORM_LAW_WEBHOOK_SECRET=
SOLE_TAX_WEBHOOK_SECRET=
ACCOUNTS_LAW_WEBHOOK_SECRET=
LANDLORD_TAX_WEBHOOK_SECRET=
INSURANCE_LAW_WEBHOOK_SECRET=
EMPLOY_LAW_WEBHOOK_SECRET=
PENSION_LAW_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# n8n orchestration
# ----------------------------------------------------------------------------
N8N_BASE_URL=
N8N_WEBHOOK_SHARED_SECRET=

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
JWT_SECRET=
VAT_RECORDS_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Feature flags
# ----------------------------------------------------------------------------
FEATURE_INDIA_QA=true
FEATURE_CTA_PARTNER=true
FEATURE_OSS=true
FEATURE_DRC=true
FEATURE_MARGIN=true
FEATURE_CGS=true
FEATURE_ENQUIRY=true
FEATURE_PARTIAL_EXEMPTION=true
FEATURE_THRESHOLD_RADAR=true
FEATURE_PENALTY_POINTS=true
FEATURE_CROSSSELL=true
